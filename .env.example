# Runtime
NODE_ENV=production
PORT=3000
CANONICAL_ORIGIN=https://somodels.buscarr.com.br
SITE_NAME=Só Models
APP_RELEASE=git-sha
TRUST_PROXY=true
ALLOWED_ORIGIN=https://somodels.buscarr.com.br

# Database and existing OAuth/storage integration
DATABASE_URL=mysql://user:password@mysql-host:3306/somodels
JWT_SECRET=generate-a-random-secret-of-at-least-32-characters
VITE_APP_ID=provided-by-oauth-provider
VITE_OAUTH_PORTAL_URL=https://oauth.example.com/login
OAUTH_SERVER_URL=https://oauth.example.com
OWNER_OPEN_ID=owner-open-id
BUILT_IN_FORGE_API_URL=https://storage.example.com/
BUILT_IN_FORGE_API_KEY=server-side-secret

# Homologation contract: use only in an isolated test environment.
# These values allow synthetic accounts and demo profiles, never real documents,
# biometrics, addresses, phone numbers, payment, email delivery or webhooks.
APP_MODE=production
PUBLIC_ACCESS_ENABLED=false
PUBLIC_LAUNCH_ENABLED=false
ALLOW_TEST_SIGNUP=false
ALLOW_FAKE_DATA=false
ALLOW_DEMO_SEED=false
TEST_MODE=false
TEST_ACCESS_ENABLED=false
DEMO_CONTACTS_ENABLED=false
ROBOTS_NOINDEX=true
ADMIN_EMAILS=authorized-developer@example.com

# Age and identity gates: real providers are required before any production launch.
REQUIRE_AGE_VERIFICATION=true
AGE_VERIFICATION_PROVIDER=
AGE_VERIFICATION_API_KEY=
AGE_VERIFICATION_WEBHOOK_SECRET=
AGE_VERIFICATION_TTL_HOURS=24
REQUIRE_IDENTITY_VERIFICATION=true
# Legacy alias accepted by the runtime; prefer REQUIRE_IDENTITY_VERIFICATION.
KYC_REQUIRED=true
KYC_PROVIDER=
KYC_API_KEY=
KYC_WEBHOOK_SECRET=

# Payments: keep disabled until formal provider eligibility is documented.
PAYMENTS_ENABLED=false
PAYMENT_PROVIDER=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# Bootstrap accounts: set only in the secret manager, use temporary high-entropy passwords, then rotate in /alterar-senha.
BOOTSTRAP_SUPER_ADMIN_EMAIL=
BOOTSTRAP_SUPER_ADMIN_PASSWORD=
BOOTSTRAP_DEV_EMAIL=
BOOTSTRAP_DEV_PASSWORD=

# Auth throttling
SESSION_DURATION_HOURS=12
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
